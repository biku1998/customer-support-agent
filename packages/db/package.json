{
  "name": "@pkg/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/database.types.d.ts",
      "import": "./dist/database.types.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "smoke": "node --env-file=../../.env.local --import tsx ./src/smoke.ts",
    "test-schema": "node --env-file=../../.env.local --import tsx ./src/test-schema.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1"
  },
  "devDependencies": {
    "@pkg/config": "workspace:*",
    "@types/node": "^22.13.1",
    "dotenv": "^17.2.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
