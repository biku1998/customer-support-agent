{
  "name": "@pkg/ingest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "inspect": "node --import tsx ./src/techqa/inspect.ts",
    "ingest": "node --env-file=../../.env.local --import tsx ./bin/ingest.ts",
    "test-similarity": "node --env-file=../../.env.local --import tsx ./bin/test-similarity.ts"
  },
  "dependencies": {
    "@pkg/db": "workspace:^",
    "@pkg/shared": "workspace:*",
    "ai": "^6.0.59",
    "openai": "^6.17.0"
  },
  "devDependencies": {
    "@pkg/config": "workspace:*",
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
